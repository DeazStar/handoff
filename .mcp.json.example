{
  "mcpServers": {
    "jobhunt": {
      "command": "node",
      "args": [
        "packages/mcp/dist/main.js"
      ],
      "env": {
        "JOBHUNT_HOME": "${HOME}/.jobhunt"
      }
    },
    "playwright": {
      "command": "node",
      "args": [
        "scripts/playwright-mcp.mjs"
      ]
    }
  }
}
